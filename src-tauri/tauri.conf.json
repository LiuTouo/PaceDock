{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrameAnchor",
  "version": "0.2.9",
  "identifier": "com.frameanchor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:benchmark-assets && npm run verify:benchmark-assets",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FrameAnchor",
        "width": 1200,
        "height": 720,
        "minWidth": 1280,
        "minHeight": 720,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": ["resources/benchmark/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "process": {},
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCRjhENjNDMTZDMDExMkQKUldRdEVjQVdQTmI0bTZtZzNSTkJpY0lsOVM5dTJtQ2ZnQ3VLZjEvQnVESVlWQW4xZmREVGtPa0YK",
      "endpoints": [
        "https://github.com/LiuTouo/FrameAnchor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
